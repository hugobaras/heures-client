# Base SQLite (développement local) — en prod : PostgreSQL (Neon, etc.)
DATABASE_URL="file:./dev.db"

# E-mail du compte qui gère tout l’outil (clients, saisies, création de devis).
# Les autres comptes ne voient que les devis dont le client a le même e-mail.
# Si vide : tout utilisateur connecté est traité comme propriétaire (développement).
APP_OWNER_EMAIL=""

# Compte admin créé / mis à jour par `npm run db:seed` (mot de passe en clair dans l’env, hashé au seed)
SEED_ADMIN_EMAIL="admin@local.dev"
SEED_ADMIN_PASSWORD="changeme123"
# Mettre à 1 pour forcer la mise à jour du hash admin au prochain seed
# SEED_RESET_ADMIN_PASSWORD=""

# Optionnel : URL publique en production (Vercel le renseigne souvent automatiquement)
# AUTH_URL="https://votre-domaine.tld"

# Métadonnées PDF / devis
INVOICE_COMPANY_NAME="Votre nom ou société"
# INVOICE_SIRET=""
# INVOICE_VAT_NUMBER=""
# INVOICE_ADDRESS="Adresse multiligne ou une ligne"
