generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id          String      @id @default(cuid())
  name        String
  email       String?
  defaultRate Decimal
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeEntries TimeEntry[]
  quotes      Quote[]
}

model TimeCategory {
  id        String      @id @default(cuid())
  slug      String      @unique
  label     String
  factor    Decimal
  sortOrder Int         @default(0)
  entries   TimeEntry[]
}

model TimeEntry {
  id              String       @id @default(cuid())
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categoryId      String
  category        TimeCategory @relation(fields: [categoryId], references: [id])
  appliedFactor   Decimal
  date            DateTime
  durationMinutes Int
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Quote {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String?
  periodStart DateTime
  periodEnd   DateTime
  status      String      @default("draft")
  vatRate     Decimal?
  createdAt   DateTime    @default(now())
  lines       QuoteLine[]
}

model QuoteLine {
  id            String  @id @default(cuid())
  quoteId       String
  quote         Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label         String
  billableHours Decimal
  unitPrice     Decimal
  lineTotal     Decimal
  sortOrder     Int     @default(0)
}
